	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"quiz",
		"flashcards",
		"spaced-repetition"
	],
	"license": "MIT",
	"dependencies": {
		"@codemirror/commands": "^6.0.1",
		"@codemirror/lang-javascript": "^6.0.2",
		"@codemirror/language": "^6.2.1",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@lezer/highlight": "^1.2.3"
	},
	"devDependencies": {
		"esbuild": "^0.28.2"
	}
